# Copy to keystore.properties and fill in. That file is gitignored.
# CI can set ANDROID_KEYSTORE_FILE / ANDROID_KEYSTORE_PASSWORD /
# ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD instead.
#
# Create the keystore with:
#   keytool -genkeypair -v -keystore upload.jks -keyalg RSA -keysize 4096 \
#           -validity 10000 -alias upload
#
# Back it up. Losing it means you can never update the app on Play again.
storeFile=upload.jks
storePassword=
keyAlias=upload
keyPassword=
